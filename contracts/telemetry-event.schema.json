{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nddev.ai/schemas/nddev-device-sync/v2/telemetry-event.schema.json",
  "title": "TelemetryEvent",
  "description": "Closed flat process envelope matching the server producer. The ingress also enforces a maximum encoded size of 16384 UTF-8 bytes; JSON Schema validation alone does not enforce a byte budget. Context uses matched routes and stable error classes, never raw request data.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "severity": {
      "type": "string",
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    "service.name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    },
    "service.version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    },
    "release.channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    },
    "release.version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    },
    "standards.release": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    },
    "deployment.environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    },
    "event.name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    },
    "source.repository": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?![\\s\\S])"
    },
    "source.commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|unknown)(?![\\s\\S])"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^(?!0{32})[0-9a-f]{32}(?![\\s\\S])"
    },
    "span_id": {
      "type": "string",
      "pattern": "^(?!0{16})[0-9a-f]{16}(?![\\s\\S])"
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS",
        "PATCH",
        "CONNECT",
        "TRACE",
        "OTHER"
      ]
    },
    "route": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:/[A-Za-z0-9_{}:/.-]*|unmatched)(?![\\s\\S])"
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400000
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "rejected",
        "started",
        "checked",
        "ready",
        "unavailable",
        "provider_accepted",
        "stopped",
        "pending",
        "approved",
        "denied",
        "accepted"
      ]
    },
    "error.type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "A fixed redacted producer error class. The current server also emits fixed human-readable error classes; never driver text, URLs or dynamic messages."
    },
    "resource": {
      "type": "string",
      "enum": [
        "connections",
        "requests"
      ]
    },
    "rejected_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "string",
      "enum": [
        "http",
        "transport",
        "database",
        "io",
        "process"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "expired",
        "event_budget",
        "process_exit",
        "operator"
      ]
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900
    },
    "event_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "address": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[0-9a-fA-F:.\\[\\]]+(?![\\s\\S])"
    },
    "transport": {
      "type": "string",
      "enum": [
        "http",
        "https"
      ]
    },
    "deadline_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "max_connections": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "migration.version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "producer.instance_id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "producer.sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "auth_method": {
      "type": "string",
      "enum": [
        "email_otp",
        "github"
      ]
    },
    "available": {
      "type": "boolean"
    },
    "credentials_verified": {
      "type": "boolean"
    },
    "challenge_invalidated": {
      "type": "boolean"
    },
    "email_available": {
      "type": "boolean"
    },
    "github_available": {
      "type": "boolean"
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "backoff_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "dropped_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mailbox_delivery": {
      "type": "string",
      "enum": [
        "unverified"
      ]
    },
    "device.id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    },
    "user.id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    },
    "tenant.id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])"
    }
  },
  "required": [
    "timestamp",
    "severity",
    "service.name",
    "service.version",
    "release.channel",
    "release.version",
    "standards.release",
    "deployment.environment",
    "module",
    "event.name",
    "source.repository",
    "source.commit"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "producer.instance_id": [
      "producer.sequence"
    ],
    "producer.sequence": [
      "producer.instance_id"
    ]
  }
}
